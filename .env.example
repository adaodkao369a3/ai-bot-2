DISCORD_TOKEN=
GROQ_API_KEY=
SUPABASE_DATABASE_URL=
KLIPY_KEY=
YOUTUBE_API_KEY=

# Optional: override the Groq chat model (default: openai/gpt-oss-20b).
# Groq periodically deprecates/decommissions models - if that happens again,
# check https://console.groq.com/docs/models for the current production
# lineup and set this instead of editing code.
GROQ_MODEL=

# Optional: how hard openai/gpt-oss models "think" before replying: low | medium | high
# (default: low). Lower = fewer hidden tokens = more replies per minute under Groq's
# tokens-per-minute limit. Ignored by non-gpt-oss models.
GROQ_REASONING_EFFORT=

# Optional: max completion tokens per reply (default: 300). On gpt-oss models the
# hidden reasoning tokens count toward this cap, so don't set it too low.
AI_MAX_TOKENS=

# Optional: enables full TLS certificate verification (verify-full) for the
# PostgreSQL pool instead of the rejectUnauthorized:false fallback. Get this
# from the Supabase Dashboard -> Database -> Settings -> SSL Configuration ->
# Download Certificate Authority (CA) certificate. A CA certificate is public
# information, not a secret, but keep it in a variable/file rather than
# committed to source control since it's environment-specific.
# Set ONE of the following (inline PEM contents, or a path to a mounted file):
SUPABASE_DB_CA_CERT=
SUPABASE_DB_CA_CERT_PATH=

# ---- Optional tuning (all have sensible defaults, set on Railway only if you want to change them) ----

# Idle meme: after someone calls the bot and the channel goes quiet (~5 min) it posts ONE meme in
# that channel, then nothing until it is called again. Set to false to turn it off.
MEME_IDLE_ENABLED=

# GIF copycat: once in a while the bot posts the same GIF someone just posted.
GIF_COPY_ENABLED=
GIF_COPY_CHANCE=              # 0-1, default 0.10 (10% of GIFs)
GIF_COPY_CHANNEL_COOLDOWN_MS= # default 600000 (10 min)
GIF_COPY_USER_COOLDOWN_MS=    # default 1800000 (30 min)

# GIF library: remembers GIFs people post (link + keywords only) and reuses one when it fits a reply.
# Run migrations/006_gif_library.sql to keep them across restarts (works in memory without it).
GIF_LIBRARY_ENABLED=

# Server custom emojis in replies.
CUSTOM_EMOJI_ENABLED=
CUSTOM_EMOJI_OFFER_CHANCE=    # 0-1, default 0.4 (chance a reply is even allowed one)
